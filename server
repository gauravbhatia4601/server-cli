#!/usr/bin/env bash
#
# server — launch SSH sessions from ~/.ssh/config aliases.
#
#   server [pattern]   fuzzy-connect to a server (no pattern: picker)
#   server -           reconnect to the last-used server
#   server list        list servers (alias + user@host:port)
#   server search <t>  search aliases, hostnames and users
#   server ping <name> TCP reachability probe
#   server @<tag>      list hosts with a tag
#   server @group:<g>  list hosts in a group
#   server tags        list all tags
#   server groups      list all groups
#   server tag <h> <t> add a tag to a host
#   server untag <h> <t> remove a tag from a host
#   server group <h> <g> set a host's group
#   server info <name> show one server's details
#   server rm <name>   remove a server (interactive, with backup)
#   server edit        open ~/.ssh/config in your editor
#   server help        show help
#   server version     show version
#
# Design notes:
#   * Zero dependencies; bash 3.2-compatible (macOS system bash).
#   * The ssh config is parsed once per invocation (single awk pass).
#   * The final ssh/editor call is `exec`'d: no extra process, exit
#     code propagates, minimal memory footprint.
#   * LC_ALL=C is scoped per grep/awk call (C-locale grep is ~10x
#     faster) but never exported, so ssh never inherits it.

set -euo pipefail

readonly VERSION='0.4.0'
readonly CONFIG="${SERVER_SSH_CONFIG:-${SSH_CONFIG:-$HOME/.ssh/config}}"
readonly SSH_BIN="${SERVER_SSH:-ssh}"
readonly STATE_FILE="${SERVER_STATE_FILE:-$HOME/.config/server-cli/state}"
readonly PROBE_TIMEOUT=3

# ANSI colors — only when stdout is a terminal (never pollutes pipes).
if [[ -t 1 ]]; then
  readonly C_GREEN=$'\033[32m' C_RED=$'\033[31m' C_BOLD=$'\033[1m' C_RESET=$'\033[0m'
else
  readonly C_GREEN='' C_RED='' C_BOLD='' C_RESET=''
fi

# awk: print every Host alias; skip wildcard/negation entries ("*", "!foo").
readonly AWK_HOSTS='
/^[[:space:]]*Host[[:space:]]/ {
  for (i = 2; i <= NF; i++)
    if ($i !~ /^[!*]/) print $i
}'

# awk: emit one record per alias: alias|hostname|user|port|tags|group.
# Filters: t (search term), tag (tag filter), grp (group filter).
# `|` is a non-whitespace delimiter so empty fields survive IFS splitting.
# Tags/groups live in `# @tags: a, b` / `# @group: name` comments above
# each Host block.
readonly AWK_RECORDS='
BEGIN { term = tolower(t); tagf = tolower(tag); grpf = tolower(grp) }
/^[[:space:]]*#[[:space:]]*@tags:/ {
  sub(/^[[:space:]]*#[[:space:]]*@tags:[[:space:]]*/, "")
  pending_tags = $0
  next
}
/^[[:space:]]*#[[:space:]]*@group:/ {
  sub(/^[[:space:]]*#[[:space:]]*@group:[[:space:]]*/, "")
  pending_group = $0
  next
}
/^[[:space:]]*Host[[:space:]]/ {
  flush()
  delete aliases
  n = 0
  for (i = 2; i <= NF; i++)
    if ($i !~ /^[!*]/) aliases[++n] = $i
  hostname = ""; user = ""; port = ""
  tags = pending_tags; group = pending_group
  pending_tags = ""; pending_group = ""
  next
}
/^[[:space:]]*HostName[[:space:]]/ { hostname = $2; next }
/^[[:space:]]*User[[:space:]]/ { user = $2; next }
/^[[:space:]]*Port[[:space:]]/ { port = $2; next }
END { flush() }

function flush(  i) {
  for (i = 1; i <= n; i++) {
    if (term != "" &&
        index(tolower(aliases[i]), term) == 0 &&
        index(tolower(hostname), term) == 0 &&
        index(tolower(user), term) == 0)
      continue
    if (tagf != "" && !has_tag(tags, tagf)) continue
    if (grpf != "" && tolower(group) != grpf) continue
    printf "%s|%s|%s|%s|%s|%s\n", aliases[i], hostname, user, port, tags, group
  }
}

function has_tag(s, tag,   arr, i) {
  n = split(s, arr, ",")
  for (i = 1; i <= n; i++) {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", arr[i])
    if (tolower(arr[i]) == tag) return 1
  }
  return 0
}'

# awk: mutate a host's header comments. action a ∈ {addtag, untag, setgroup};
# value v is the tag/group. Buffers comment lines so order is preserved.
readonly AWK_MUTATE='
BEGIN { target = t; action = a; value = v }
/^[[:space:]]*#/ {
  buf[nbuf++] = $0
  next
}
{
  if (/^[[:space:]]*Host[[:space:]]/) {
    in_target = 0
    for (i = 2; i <= NF; i++) if ($i == target) in_target = 1
    if (in_target) {
      if (action == "addtag") {
        found = 0
        for (i = 0; i < nbuf; i++) {
          if (buf[i] ~ /^[[:space:]]*#[[:space:]]*@tags:/) {
            if (!has_tag(buf[i], value)) buf[i] = buf[i] ", " value
            found = 1
          }
        }
        if (!found) buf[nbuf++] = "# @tags: " value
      } else if (action == "untag") {
        for (i = 0; i < nbuf; i++) {
          if (buf[i] ~ /^[[:space:]]*#[[:space:]]*@tags:/) {
            newline = remove_tag(buf[i], value)
            if (newline == "") {
              for (j = i; j < nbuf - 1; j++) buf[j] = buf[j + 1]
              nbuf--
            } else {
              buf[i] = newline
            }
            break
          }
        }
      } else if (action == "setgroup") {
        found = 0
        for (i = 0; i < nbuf; i++) {
          if (buf[i] ~ /^[[:space:]]*#[[:space:]]*@group:/) {
            buf[i] = "# @group: " value
            found = 1
          }
        }
        if (!found) buf[nbuf++] = "# @group: " value
      }
    }
  }
  for (i = 0; i < nbuf; i++) print buf[i]
  nbuf = 0
  print
}
END { for (i = 0; i < nbuf; i++) print buf[i] }

function has_tag(line, tag,   s, arr, i) {
  s = line
  sub(/^[[:space:]]*#[[:space:]]*@tags:[[:space:]]*/, "", s)
  n = split(s, arr, ",")
  for (i = 1; i <= n; i++) {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", arr[i])
    if (arr[i] == tag) return 1
  }
  return 0
}

function remove_tag(line, tag,   s, arr, i, out) {
  s = line
  sub(/^[[:space:]]*#[[:space:]]*@tags:[[:space:]]*/, "", s)
  n = split(s, arr, ",")
  out = ""
  for (i = 1; i <= n; i++) {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", arr[i])
    if (arr[i] != tag) {
      if (out == "") out = arr[i]; else out = out ", " arr[i]
    }
  }
  if (out == "") return ""
  return "# @tags: " out
}'

# awk: count tags (tag<TAB>count).
readonly AWK_TAGS='
/^[[:space:]]*#[[:space:]]*@tags:/ {
  sub(/^[[:space:]]*#[[:space:]]*@tags:[[:space:]]*/, "")
  n = split($0, arr, ",")
  for (i = 1; i <= n; i++) {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", arr[i])
    if (arr[i] != "") count[tolower(arr[i])]++
  }
}
END { for (t in count) printf "%s\t%d\n", t, count[t] }'

# awk: count groups (group<TAB>count).
readonly AWK_GROUPS='
/^[[:space:]]*#[[:space:]]*@group:/ {
  sub(/^[[:space:]]*#[[:space:]]*@group:[[:space:]]*/, "")
  gsub(/^[[:space:]]+|[[:space:]]+$/, "")
  if ($0 != "") count[tolower($0)]++
}
END { for (g in count) printf "%s\t%d\n", g, count[g] }'

# awk: print properties (HostName/User/Port/...) of the block owning alias t.
readonly AWK_INFO='
/^[[:space:]]*Host[[:space:]]/ {
  in_block = 0
  for (i = 2; i <= NF; i++) if ($i == t) in_block = 1
  next
}
in_block && /^[[:space:]]*[A-Za-z][A-Za-z0-9_-]*[[:space:]]/ {
  v = $0
  sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", v)
  print $1 ": " v
}'

# awk: preview the block that would be removed by `rm`.
readonly AWK_RM_PREVIEW='
/^[[:space:]]*Host[[:space:]]/ {
  in_block = 0
  for (i = 2; i <= NF; i++) if ($i == t) in_block = 1
  removing = 0
  if (in_block) {
    print
    if (NF == 2) removing = 1
  }
  next
}
removing { print }'

# awk: write new config with alias t removed (multi-alias Host lines
# keep their remaining aliases).
readonly AWK_RM_FILTER='
/^[[:space:]]*Host[[:space:]]/ {
  in_block = 0
  for (i = 2; i <= NF; i++) if ($i == t) in_block = 1
  skip_block = 0
  if (in_block) {
    if (NF == 2) {
      skip_block = 1
      next
    }
    line = $1
    for (i = 2; i <= NF; i++) if ($i != t) line = line " " $i
    print line
    next
  }
}
skip_block { next }
{ print }'

# ── helpers ─────────────────────────────────────────────────────────

# Print an error to stderr and exit nonzero.
die() {
  printf '%s\n' "${C_RED}server: $*${C_RESET}" >&2
  exit 1
}

# Load host aliases from CONFIG into the global HOSTS array.
# Word-splitting is safe (aliases are whitespace-free); noglob guards
# against wildcard aliases being glob-expanded during assignment.
load_hosts() {
  HOSTS=()
  [[ -r "$CONFIG" ]] || return 0
  local names
  names="$(LC_ALL=C awk "$AWK_HOSTS" "$CONFIG" 2>/dev/null)" || return 0
  set -f
  HOSTS=($names)
  set +f
}

# Fill the global MATCHES array for PATTERN. Exact match wins; falls
# back to case-insensitive substring. Empty pattern → all hosts.
find_matches() {
  local pattern="$1"
  MATCHES=()
  if [[ -z "$pattern" ]]; then
    MATCHES=("${HOSTS[@]+"${HOSTS[@]}"}")
    return 0
  fi
  local found
  found="$(printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fix -- "$pattern" 2>/dev/null)" || true
  if [[ -z "$found" ]]; then
    found="$(printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fi -- "$pattern" 2>/dev/null)" || true
  fi
  set -f
  MATCHES=($found)
  set +f
}

# Print records (alias|hostname|user|port|tags|group) as aligned rows.
# Reads from stdin; returns 0 if any row was printed.
print_records() {
  local alias hostname user port tags group target meta
  local -i count=0
  while IFS='|' read -r alias hostname user port tags group; do
    [[ -n "$alias" ]] || continue
    (( count += 1 ))
    target="${hostname}"
    if [[ -n "$user" ]]; then target="${user}@${target}"; fi
    if [[ -n "$port" ]]; then target="${target}:${port}"; fi
    meta=''
    if [[ -n "$tags" ]]; then meta="  [${tags}]"; fi
    if [[ -n "$group" ]]; then meta="${meta} (${group})"; fi
    printf '  %-20s %s%s\n' "$alias" "$target" "$meta"
  done
  (( count > 0 ))
}

# Persist the last-connected alias for `server -`.
record_last() {
  local target="$1"
  mkdir -p "${STATE_FILE%/*}" 2>/dev/null || true
  printf '%s\n' "$target" > "$STATE_FILE"
}

# Resolve an alias to its HostName and Port; sets HOSTNAME_VAL / PORT_VAL.
lookup_host() {
  local target="$1"
  HOSTNAME_VAL=''; PORT_VAL=''
  local alias hostname user port tags group
  while IFS='|' read -r alias hostname user port tags group; do
    if [[ "$alias" == "$target" ]]; then
      HOSTNAME_VAL="$hostname"
      PORT_VAL="${port:-22}"
      return 0
    fi
  done < <(LC_ALL=C awk -v t='' "$AWK_RECORDS" "$CONFIG" 2>/dev/null)
  return 1
}

# TCP reachability probe using bash's /dev/tcp (no external deps).
# Returns 0 if host:port accepts a connection within PROBE_TIMEOUT.
probe_tcp() {
  local hostname="$1" port="$2"
  local -i deadline=$((SECONDS + PROBE_TIMEOUT))
  ( exec 3<>"/dev/tcp/${hostname}/${port}" ) 2>/dev/null &
  local pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if (( SECONDS >= deadline )); then
      kill "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      return 1
    fi
    sleep 0.1
  done
  wait "$pid"
}

# Rewrite CONFIG applying a header mutation (addtag/untag/setgroup).
# Backs up first, writes atomically with 600 perms.
mutate_config() {
  local host="$1" action="$2" value="$3" msg="$4"
  local tmp="${CONFIG}.tmp.$$"
  trap 'rm -f "$CONFIG.tmp.$$"' EXIT
  cp "$CONFIG" "$CONFIG.server.bak"
  LC_ALL=C awk -v t="$host" -v a="$action" -v v="$value" "$AWK_MUTATE" "$CONFIG" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$CONFIG"
  echo "$msg" >&2
}

# Require an exact host alias; returns 1 (with message) if missing.
require_host() {
  local host="$1"
  load_hosts
  printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fxq -- "$host" || {
    echo "No server named '$host'." >&2
    return 1
  }
}

# Interactive numbered picker; prints ONLY the chosen host on stdout.
# The menu itself goes to stderr so stdout stays machine-readable
# (pick is called via command substitution).
# Returns 1 on abort/invalid input.
pick() {
  local -a options=("$@")
  local n="${#options[@]}" i choice
  for ((i = 0; i < n; i++)); do
    printf '  [%2d] %s\n' "$((i + 1))" "${options[i]}" >&2
  done
  if ! read -r -p "Pick a server (1-${n}) or [q]uit: " choice; then
    echo
    return 1
  fi
  case "$choice" in
    '' | q | Q) echo 'Aborted.' >&2; return 1 ;;
  esac
  if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= n)); then
    echo "${options[choice - 1]}"
    return 0
  fi
  echo "Invalid choice: $choice" >&2
  return 1
}

# ── commands ───────────────────────────────────────────────────────

# Default command: resolve PATTERN to one host, then exec ssh.
cmd_connect() {
  local pattern="${1:-}"
  load_hosts
  find_matches "$pattern"
  local target picked
  case "${#MATCHES[@]}" in
    0)
      if [[ -n "$pattern" ]]; then
        echo "No server matches '$pattern'. See 'server list'." >&2
      else
        echo "No servers found in $CONFIG" >&2
      fi
      return 1
      ;;
    1)
      target="${MATCHES[0]}"
      ;;
    *)
      if [[ -z "$pattern" ]]; then
        echo 'Available servers:' >&2
      else
        echo "Multiple matches for '$pattern':" >&2
      fi
      picked="$(pick "${MATCHES[@]}")" || return 1
      target="$picked"
      ;;
  esac
  printf 'Connecting to %s ...\n' "${C_GREEN}${target}${C_RESET}" >&2
  record_last "$target"
  exec "$SSH_BIN" "$target"
}

cmd_list() {
  [[ -r "$CONFIG" ]] || { echo "No servers in $CONFIG" >&2; return 1; }
  LC_ALL=C awk -v t='' -v tag='' -v grp='' "$AWK_RECORDS" "$CONFIG" 2>/dev/null | print_records || {
    echo "No servers in $CONFIG" >&2
    return 1
  }
}

cmd_search() {
  local term="${1:-}"
  [[ -n "$term" ]] || { echo 'Usage: server search <term>' >&2; return 2; }
  [[ -r "$CONFIG" ]] || { echo "No servers in $CONFIG" >&2; return 1; }
  LC_ALL=C awk -v t="$term" -v tag='' -v grp='' "$AWK_RECORDS" "$CONFIG" 2>/dev/null | print_records || {
    echo "No match for '$term'." >&2
    return 1
  }
}

cmd_filter_tag() {
  local tag="${1:-}"
  [[ -n "$tag" ]] || { echo 'Usage: server @<tag>' >&2; return 2; }
  [[ -r "$CONFIG" ]] || { echo "No servers in $CONFIG" >&2; return 1; }
  LC_ALL=C awk -v t='' -v tag="$tag" -v grp='' "$AWK_RECORDS" "$CONFIG" 2>/dev/null | print_records || {
    echo "No hosts tagged '$tag'." >&2
    return 1
  }
}

cmd_filter_group() {
  local grp="${1:-}"
  [[ -n "$grp" ]] || { echo 'Usage: server @group:<name>' >&2; return 2; }
  [[ -r "$CONFIG" ]] || { echo "No servers in $CONFIG" >&2; return 1; }
  LC_ALL=C awk -v t='' -v tag='' -v grp="$grp" "$AWK_RECORDS" "$CONFIG" 2>/dev/null | print_records || {
    echo "No hosts in group '$grp'." >&2
    return 1
  }
}

cmd_tags() {
  [[ -r "$CONFIG" ]] || { echo "No servers in $CONFIG" >&2; return 1; }
  local out tag count
  out="$(LC_ALL=C awk "$AWK_TAGS" "$CONFIG" 2>/dev/null | sort)" || true
  if [[ -z "$out" ]]; then
    echo 'No tags defined.' >&2
    return 1
  fi
  while read -r tag count; do
    printf '  %-20s %s\n' "$tag" "$count"
  done <<< "$out"
}

cmd_groups() {
  [[ -r "$CONFIG" ]] || { echo "No servers in $CONFIG" >&2; return 1; }
  local out grp count
  out="$(LC_ALL=C awk "$AWK_GROUPS" "$CONFIG" 2>/dev/null | sort)" || true
  if [[ -z "$out" ]]; then
    echo 'No groups defined.' >&2
    return 1
  fi
  while read -r grp count; do
    printf '  %-20s %s\n' "$grp" "$count"
  done <<< "$out"
}

cmd_tag_add() {
  local host="${1:-}" tag="${2:-}"
  [[ -n "$host" && -n "$tag" ]] || { echo 'Usage: server tag <host> <tag>' >&2; return 2; }
  if [[ "$tag" =~ [[:space:],|] ]]; then
    echo "Invalid tag: '$tag' (no spaces, commas or |)" >&2
    return 2
  fi
  require_host "$host" || return 1
  mutate_config "$host" addtag "$tag" "Tagged '$host' with '$tag'."
}

cmd_untag() {
  local host="${1:-}" tag="${2:-}"
  [[ -n "$host" && -n "$tag" ]] || { echo 'Usage: server untag <host> <tag>' >&2; return 2; }
  require_host "$host" || return 1
  mutate_config "$host" untag "$tag" "Removed tag '$tag' from '$host'."
}

cmd_group_set() {
  local host="${1:-}" name="${2:-}"
  [[ -n "$host" && -n "$name" ]] || { echo 'Usage: server group <host> <name>' >&2; return 2; }
  if [[ "$name" =~ [[:space:],|] ]]; then
    echo "Invalid group name: '$name'" >&2
    return 2
  fi
  require_host "$host" || return 1
  mutate_config "$host" setgroup "$name" "Set group '$name' for '$host'."
}

cmd_last() {
  local last
  [[ -r "$STATE_FILE" ]] || { echo 'No previous connection.' >&2; return 1; }
  last="$(< "$STATE_FILE")" || return 1
  [[ -n "$last" ]] || { echo 'No previous connection.' >&2; return 1; }
  cmd_connect "$last"
}

cmd_ping() {
  local target="${1:-}"
  [[ -n "$target" ]] || { echo 'Usage: server ping <name>' >&2; return 2; }
  load_hosts
  find_matches "$target"
  local host
  case "${#MATCHES[@]}" in
    0) echo "No server matches '$target'." >&2; return 1 ;;
    1) host="${MATCHES[0]}" ;;
    *) echo "Multiple matches for '$target' — be specific." >&2; return 1 ;;
  esac
  lookup_host "$host" || { echo "No server named '$host'." >&2; return 1; }
  local hostname="${HOSTNAME_VAL}" port="${PORT_VAL}"
  [[ -n "$hostname" ]] || { echo "No HostName for '$host'." >&2; return 1; }
  printf 'Probing %s:%s ... ' "$hostname" "$port"
  if probe_tcp "$hostname" "$port"; then
    printf '%s\n' "${C_GREEN}reachable${C_RESET}"
    return 0
  else
    printf '%s\n' "${C_RED}unreachable${C_RESET}"
    return 1
  fi
}

cmd_info() {
  load_hosts
  local target="$1" found
  found="$(LC_ALL=C awk -v t="$target" "$AWK_INFO" "$CONFIG" 2>/dev/null)" || true
  if [[ -z "$found" ]]; then
    echo "No server named '$target'." >&2
    return 1
  fi
  echo "  Alias: $target"
  echo "$found" | sed 's/^/  /'
}

cmd_rm() {
  load_hosts
  local target="${1:-}"
  [[ -n "$target" ]] || { echo 'Usage: server rm <name>' >&2; return 2; }

  # Aliases are case-sensitive in ssh — require an exact match.
  local exact tmp
  exact="$(printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fx -- "$target")" || {
    echo "No server named '$target'." >&2
    return 1
  }

  tmp="${CONFIG}.tmp.$$"
  # Global refs only: locals are destroyed before traps fire.
  trap 'rm -f "$CONFIG.tmp.$$"' EXIT

  echo "Removing '${C_BOLD}${target}${C_RESET}':"
  LC_ALL=C awk -v t="$target" "$AWK_RM_PREVIEW" "$CONFIG" | sed 's/^/  /'

  local ans
  read -r -p 'Continue? [y/N] ' ans || { echo; return 1; }
  case "$ans" in
    y | Y) ;;
    *) echo 'Aborted.'; return 1 ;;
  esac

  cp "$CONFIG" "$CONFIG.server.bak"
  LC_ALL=C awk -v t="$target" "$AWK_RM_FILTER" "$CONFIG" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$CONFIG"
  echo "Removed. Backup saved at $CONFIG.server.bak"
}

cmd_add() {
  load_hosts
  echo "Adding a server to ${C_BOLD}${CONFIG}${C_RESET}" >&2
  local alias_name hostname user port key ans

  # Alias: required, unique among existing aliases.
  while :; do
    read -r -p 'Alias name: ' alias_name || { echo; return 1; }
    if [[ ! "$alias_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
      echo '  invalid alias: use letters, digits, ".", "_" or "-"; no spaces' >&2
      continue
    fi
    if printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fxq -- "$alias_name"; then
      echo "  '$alias_name' already exists ('server edit' to change it)" >&2
      continue
    fi
    break
  done

  # HostName/IP: required, no whitespace.
  while :; do
    read -r -p 'HostName or IP: ' hostname || { echo; return 1; }
    if [[ -z "$hostname" ]]; then
      echo '  HostName is required' >&2
      continue
    fi
    if [[ "$hostname" =~ [[:space:]] ]]; then
      echo '  HostName cannot contain spaces' >&2
      continue
    fi
    break
  done

  read -r -p 'User (blank to skip): ' user || { echo; return 1; }

  while :; do
    read -r -p 'Port (blank to skip): ' port || { echo; return 1; }
    if [[ -z "$port" || "$port" =~ ^[0-9]+$ ]]; then
      break
    fi
    echo '  Port must be a number' >&2
  done

  read -r -p 'IdentityFile path (blank to skip): ' key || { echo; return 1; }
  if [[ -n "$key" ]]; then
    key="${key/#\~/$HOME}"   # expand a leading ~
    [[ -r "$key" ]] || echo "  warning: '$key' is not readable (saving anyway)" >&2
  fi

  # Preview + confirm.
  {
    echo ''
    echo "Host $alias_name"
    echo "  HostName $hostname"
    if [[ -n "$user" ]]; then echo "  User $user"; fi
    if [[ -n "$port" ]]; then echo "  Port $port"; fi
    if [[ -n "$key" ]]; then echo "  IdentityFile $key"; fi
  } | sed 's/^/  /' >&2

  read -r -p 'Save? [y/N] ' ans || { echo; return 1; }
  case "$ans" in
    y | Y) ;;
    *) echo 'Aborted.' >&2; return 1 ;;
  esac

  # Backup, then append (ensure the file exists and ends with a newline).
  [[ -f "$CONFIG" ]] && cp "$CONFIG" "$CONFIG.server.bak"
  if [[ ! -f "$CONFIG" ]]; then
    mkdir -p "${CONFIG%/*}" 2>/dev/null || true
    : > "$CONFIG"
    chmod 600 "$CONFIG"
  elif [[ -s "$CONFIG" && -n "$(tail -c 1 "$CONFIG")" ]]; then
    printf '\n' >> "$CONFIG"
  fi
  {
    printf '\nHost %s\n  HostName %s\n' "$alias_name" "$hostname"
    if [[ -n "$user" ]]; then printf '  User %s\n' "$user"; fi
    if [[ -n "$port" ]]; then printf '  Port %s\n' "$port"; fi
    if [[ -n "$key" ]]; then printf '  IdentityFile %s\n' "$key"; fi
  } >> "$CONFIG"

  echo "Added: $alias_name → $hostname" >&2
}

cmd_edit() {
  local target="${1:-}" editor_str line
  editor_str="${VISUAL:-${EDITOR:-nano}}"
  local -a ed
  set -f
  ed=($editor_str)
  set +f
  ((${#ed[@]} > 0)) || ed=(nano)

  if [[ -n "$target" ]]; then
    load_hosts
    # Locate the Host line so line-capable editors can jump straight to it.
    line="$(LC_ALL=C awk -v t="$target" '
      /^[[:space:]]*Host[[:space:]]/ {
        for (i = 2; i <= NF; i++)
          if ($i == t) { print NR; found = 1 }
      }
      END { if (!found) exit 1 }
    ' "$CONFIG" 2>/dev/null)" || {
      echo "No server named '$target'." >&2
      return 1
    }
    case "${ed[0]##*/}" in
      vi | vim | nvim | nano | emacs | emacsclient | less | more) ed+=("+$line") ;;
    esac
  fi

  ed+=("$CONFIG")
  exec "${ed[@]}"
}

usage() {
  cat <<'EOF'
server — launch SSH sessions from ~/.ssh/config

USAGE
  server [pattern]    connect; fuzzy match, picker when several match
  server -            reconnect to the last-used server
  server list         list servers (alias + user@host:port + tags/group)
  server search <t>   search aliases, hostnames and users
  server ping <name>  TCP reachability probe
  server @<tag>       list hosts with a tag
  server @group:<g>   list hosts in a group
  server tags         list all tags
  server groups       list all groups
  server tag <h> <t>  add a tag to a host
  server untag <h> <t> remove a tag from a host
  server group <h> <g> set a host's group
  server info <name>  show one server's details
  server add          add a new server (guided)
  server rm <name>    remove a server (asks first, keeps a backup)
  server edit [name]  open ~/.ssh/config in $EDITOR (default: nano), optionally at <name>
  server help         show this help
  server version      show version

TAGS & GROUPS
  Add `# @tags: prod, web` and/or `# @group: production` comments directly
  above a Host block (or use `server tag` / `server group`).

ENV
  SERVER_SSH_CONFIG   ssh config path (default: ~/.ssh/config)
  SERVER_SSH          ssh binary (default: ssh)
  SERVER_STATE_FILE   last-connection state (default: ~/.config/server-cli/state)
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    '' | pick) cmd_connect ;;
    -) cmd_last ;;
    list) cmd_list ;;
    search)
      (($# >= 2)) || { echo 'Usage: server search <term>' >&2; return 2; }
      cmd_search "$2"
      ;;
    tags) cmd_tags ;;
    groups) cmd_groups ;;
    tag)
      (($# >= 2)) || { echo 'Usage: server tag <tag> | server tag <host> <tag>' >&2; return 2; }
      if (($# >= 3)); then cmd_tag_add "$2" "$3"; else cmd_filter_tag "$2"; fi
      ;;
    untag)
      (($# >= 3)) || { echo 'Usage: server untag <host> <tag>' >&2; return 2; }
      cmd_untag "$2" "$3"
      ;;
    group)
      (($# >= 2)) || { echo 'Usage: server group <name> | server group <host> <name>' >&2; return 2; }
      if (($# >= 3)); then cmd_group_set "$2" "$3"; else cmd_filter_group "$2"; fi
      ;;
    @*)
      if [[ "$cmd" == @group:* ]]; then
        cmd_filter_group "${cmd#@group:}"
      else
        cmd_filter_tag "${cmd#@}"
      fi
      ;;
    ping | check)
      (($# >= 2)) || { echo 'Usage: server ping <name>' >&2; return 2; }
      cmd_ping "$2"
      ;;
    info)
      (($# >= 2)) || { echo 'Usage: server info <name>' >&2; return 2; }
      cmd_info "$2"
      ;;
    rm)
      (($# >= 2)) || { echo 'Usage: server rm <name>' >&2; return 2; }
      cmd_rm "$2"
      ;;
    add) cmd_add ;;
    edit)
      if (($# >= 2)); then
        cmd_edit "$2"
      else
        cmd_edit
      fi
      ;;
    help | -h | --help) usage ;;
    version | --version) echo "server $VERSION" ;;
    *)
      if [[ "$cmd" == -* ]]; then
        echo "Unknown option: $cmd (see 'server help')" >&2
        return 2
      fi
      cmd_connect "$cmd"
      ;;
  esac
}

main "$@"
