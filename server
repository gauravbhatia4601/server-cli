#!/usr/bin/env bash
#
# server — launch SSH sessions from ~/.ssh/config aliases.
#
#   server [pattern]   fuzzy-connect to a server (no pattern: picker)
#   server list         list all server aliases
#   server info <name>  show one server's details
#   server rm <name>    remove a server (interactive, with backup)
#   server edit         open ~/.ssh/config in your editor
#   server help         show help
#   server version      show version
#
# Design notes:
#   * Zero dependencies; bash 3.2-compatible (macOS system bash).
#   * The ssh config is parsed once per invocation (single awk pass).
#   * The final ssh/editor call is `exec`'d: no extra process, exit
#     code propagates, minimal memory footprint.
#   * LC_ALL=C is scoped per grep/awk call (C-locale grep is ~10x
#     faster) but never exported, so ssh never inherits it.

set -euo pipefail

readonly VERSION='0.2.0'
readonly CONFIG="${SERVER_SSH_CONFIG:-${SSH_CONFIG:-$HOME/.ssh/config}}"
readonly SSH_BIN="${SERVER_SSH:-ssh}"

# ANSI colors — only when stdout is a terminal (never pollutes pipes).
if [[ -t 1 ]]; then
  readonly C_GREEN=$'\033[32m' C_RED=$'\033[31m' C_BOLD=$'\033[1m' C_RESET=$'\033[0m'
else
  readonly C_GREEN='' C_RED='' C_BOLD='' C_RESET=''
fi

# awk: print every Host alias; skip wildcard/negation entries ("*", "!foo").
readonly AWK_HOSTS='
/^[[:space:]]*Host[[:space:]]/ {
  for (i = 2; i <= NF; i++)
    if ($i !~ /^[!*]/) print $i
}'

# awk: print properties (HostName/User/Port/...) of the block owning alias t.
readonly AWK_INFO='
/^[[:space:]]*Host[[:space:]]/ {
  in_block = 0
  for (i = 2; i <= NF; i++) if ($i == t) in_block = 1
  next
}
in_block && /^[[:space:]]*[A-Za-z][A-Za-z0-9_-]*[[:space:]]/ {
  v = $0
  sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", v)
  print $1 ": " v
}'

# awk: preview the block that would be removed by `rm`.
readonly AWK_RM_PREVIEW='
/^[[:space:]]*Host[[:space:]]/ {
  in_block = 0
  for (i = 2; i <= NF; i++) if ($i == t) in_block = 1
  removing = 0
  if (in_block) {
    print
    if (NF == 2) removing = 1
  }
  next
}
removing { print }'

# awk: write new config with alias t removed (multi-alias Host lines
# keep their remaining aliases).
readonly AWK_RM_FILTER='
/^[[:space:]]*Host[[:space:]]/ {
  in_block = 0
  for (i = 2; i <= NF; i++) if ($i == t) in_block = 1
  skip_block = 0
  if (in_block) {
    if (NF == 2) {
      skip_block = 1
      next
    }
    line = $1
    for (i = 2; i <= NF; i++) if ($i != t) line = line " " $i
    print line
    next
  }
}
skip_block { next }
{ print }'

# ── helpers ─────────────────────────────────────────────────────────

# Print an error to stderr and exit nonzero.
die() {
  printf '%s\n' "${C_RED}server: $*${C_RESET}" >&2
  exit 1
}

# Load host aliases from CONFIG into the global HOSTS array.
# Word-splitting is safe (aliases are whitespace-free); noglob guards
# against wildcard aliases being glob-expanded during assignment.
load_hosts() {
  HOSTS=()
  [[ -r "$CONFIG" ]] || return 0
  local names
  names="$(LC_ALL=C awk "$AWK_HOSTS" "$CONFIG" 2>/dev/null)" || return 0
  set -f
  HOSTS=($names)
  set +f
}

# Fill the global MATCHES array for PATTERN. Exact match wins; falls
# back to case-insensitive substring. Empty pattern → all hosts.
find_matches() {
  local pattern="$1"
  MATCHES=()
  if [[ -z "$pattern" ]]; then
    MATCHES=("${HOSTS[@]+"${HOSTS[@]}"}")
    return 0
  fi
  local found
  found="$(printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fix -- "$pattern" 2>/dev/null)" || true
  if [[ -z "$found" ]]; then
    found="$(printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fi -- "$pattern" 2>/dev/null)" || true
  fi
  set -f
  MATCHES=($found)
  set +f
}

# Interactive numbered picker; prints ONLY the chosen host on stdout.
# The menu itself goes to stderr so stdout stays machine-readable
# (pick is called via command substitution).
# Returns 1 on abort/invalid input.
pick() {
  local -a options=("$@")
  local n="${#options[@]}" i choice
  for ((i = 0; i < n; i++)); do
    printf '  [%2d] %s\n' "$((i + 1))" "${options[i]}" >&2
  done
  if ! read -r -p "Pick a server (1-${n}) or [q]uit: " choice; then
    echo
    return 1
  fi
  case "$choice" in
    '' | q | Q) echo 'Aborted.' >&2; return 1 ;;
  esac
  if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= n)); then
    echo "${options[choice - 1]}"
    return 0
  fi
  echo "Invalid choice: $choice" >&2
  return 1
}

# ── commands ───────────────────────────────────────────────────────

# Default command: resolve PATTERN to one host, then exec ssh.
cmd_connect() {
  local pattern="${1:-}"
  load_hosts
  find_matches "$pattern"
  local target picked
  case "${#MATCHES[@]}" in
    0)
      if [[ -n "$pattern" ]]; then
        echo "No server matches '$pattern'. See 'server list'." >&2
      else
        echo "No servers found in $CONFIG" >&2
      fi
      return 1
      ;;
    1)
      target="${MATCHES[0]}"
      ;;
    *)
      if [[ -z "$pattern" ]]; then
        echo 'Available servers:' >&2
      else
        echo "Multiple matches for '$pattern':" >&2
      fi
      picked="$(pick "${MATCHES[@]}")" || return 1
      target="$picked"
      ;;
  esac
  printf 'Connecting to %s ...\n' "${C_GREEN}${target}${C_RESET}" >&2
  exec "$SSH_BIN" "$target"
}

cmd_list() {
  load_hosts
  if (( ${#HOSTS[@]} == 0 )); then
    echo "No servers in $CONFIG" >&2
    return 1
  fi
  local host
  for host in "${HOSTS[@]}"; do
    echo "  $host"
  done
}

cmd_info() {
  load_hosts
  local target="$1" found
  found="$(LC_ALL=C awk -v t="$target" "$AWK_INFO" "$CONFIG" 2>/dev/null)" || true
  if [[ -z "$found" ]]; then
    echo "No server named '$target'." >&2
    return 1
  fi
  echo "  Alias: $target"
  echo "$found" | sed 's/^/  /'
}

cmd_rm() {
  load_hosts
  local target="${1:-}"
  [[ -n "$target" ]] || { echo 'Usage: server rm <name>' >&2; return 2; }

  # Aliases are case-sensitive in ssh — require an exact match.
  local exact tmp
  exact="$(printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fx -- "$target")" || {
    echo "No server named '$target'." >&2
    return 1
  }

  tmp="${CONFIG}.tmp.$$"
  # Global refs only: locals are destroyed before traps fire.
  trap 'rm -f "$CONFIG.tmp.$$"' EXIT

  echo "Removing '${C_BOLD}${target}${C_RESET}':"
  LC_ALL=C awk -v t="$target" "$AWK_RM_PREVIEW" "$CONFIG" | sed 's/^/  /'

  local ans
  read -r -p 'Continue? [y/N] ' ans || { echo; return 1; }
  case "$ans" in
    y | Y) ;;
    *) echo 'Aborted.'; return 1 ;;
  esac

  cp "$CONFIG" "$CONFIG.server.bak"
  LC_ALL=C awk -v t="$target" "$AWK_RM_FILTER" "$CONFIG" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$CONFIG"
  echo "Removed. Backup saved at $CONFIG.server.bak"
}

cmd_add() {
  load_hosts
  echo "Adding a server to ${C_BOLD}${CONFIG}${C_RESET}" >&2
  local alias_name hostname user port key ans

  # Alias: required, unique among existing aliases.
  while :; do
    read -r -p 'Alias name: ' alias_name || { echo; return 1; }
    if [[ ! "$alias_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
      echo '  invalid alias: use letters, digits, ".", "_" or "-"; no spaces' >&2
      continue
    fi
    if printf '%s\n' "${HOSTS[@]+"${HOSTS[@]}"}" | LC_ALL=C grep -Fxq -- "$alias_name"; then
      echo "  '$alias_name' already exists ('server edit' to change it)" >&2
      continue
    fi
    break
  done

  # HostName/IP: required, no whitespace.
  while :; do
    read -r -p 'HostName or IP: ' hostname || { echo; return 1; }
    if [[ -z "$hostname" ]]; then
      echo '  HostName is required' >&2
      continue
    fi
    if [[ "$hostname" =~ [[:space:]] ]]; then
      echo '  HostName cannot contain spaces' >&2
      continue
    fi
    break
  done

  read -r -p 'User (blank to skip): ' user || { echo; return 1; }

  while :; do
    read -r -p 'Port (blank to skip): ' port || { echo; return 1; }
    if [[ -z "$port" || "$port" =~ ^[0-9]+$ ]]; then
      break
    fi
    echo '  Port must be a number' >&2
  done

  read -r -p 'IdentityFile path (blank to skip): ' key || { echo; return 1; }
  if [[ -n "$key" ]]; then
    key="${key/#\~/$HOME}"   # expand a leading ~
    [[ -r "$key" ]] || echo "  warning: '$key' is not readable (saving anyway)" >&2
  fi

  # Preview + confirm.
  {
    echo ''
    echo "Host $alias_name"
    echo "  HostName $hostname"
    if [[ -n "$user" ]]; then echo "  User $user"; fi
    if [[ -n "$port" ]]; then echo "  Port $port"; fi
    if [[ -n "$key" ]]; then echo "  IdentityFile $key"; fi
  } | sed 's/^/  /' >&2

  read -r -p 'Save? [y/N] ' ans || { echo; return 1; }
  case "$ans" in
    y | Y) ;;
    *) echo 'Aborted.' >&2; return 1 ;;
  esac

  # Backup, then append (ensure the file exists and ends with a newline).
  [[ -f "$CONFIG" ]] && cp "$CONFIG" "$CONFIG.server.bak"
  if [[ ! -f "$CONFIG" ]]; then
    mkdir -p "${CONFIG%/*}" 2>/dev/null || true
    : > "$CONFIG"
    chmod 600 "$CONFIG"
  elif [[ -s "$CONFIG" && -n "$(tail -c 1 "$CONFIG")" ]]; then
    printf '\n' >> "$CONFIG"
  fi
  {
    printf '\nHost %s\n  HostName %s\n' "$alias_name" "$hostname"
    if [[ -n "$user" ]]; then printf '  User %s\n' "$user"; fi
    if [[ -n "$port" ]]; then printf '  Port %s\n' "$port"; fi
    if [[ -n "$key" ]]; then printf '  IdentityFile %s\n' "$key"; fi
  } >> "$CONFIG"

  echo "Added: $alias_name → $hostname" >&2
}

cmd_edit() {
  local target="${1:-}" editor_str line
  editor_str="${VISUAL:-${EDITOR:-vi}}"
  local -a ed
  set -f
  ed=($editor_str)
  set +f
  ((${#ed[@]} > 0)) || ed=(vi)

  if [[ -n "$target" ]]; then
    load_hosts
    # Locate the Host line so line-capable editors can jump straight to it.
    line="$(LC_ALL=C awk -v t="$target" '
      /^[[:space:]]*Host[[:space:]]/ {
        for (i = 2; i <= NF; i++)
          if ($i == t) { print NR; found = 1 }
      }
      END { if (!found) exit 1 }
    ' "$CONFIG" 2>/dev/null)" || {
      echo "No server named '$target'." >&2
      return 1
    }
    case "${ed[0]##*/}" in
      vi | vim | nvim | nano | emacs | emacsclient | less | more) ed+=("+$line") ;;
    esac
  fi

  ed+=("$CONFIG")
  exec "${ed[@]}"
}

usage() {
  cat <<'EOF'
server — launch SSH sessions from ~/.ssh/config

USAGE
  server [pattern]    connect; fuzzy match, picker when several match
  server list         list all server aliases
  server info <name>  show one server's details
  server add          add a new server (guided)
  server rm <name>    remove a server (asks first, keeps a backup)
  server edit [name]  open ~/.ssh/config in $EDITOR, optionally at <name>
  server help         show this help
  server version      show version

ENV
  SERVER_SSH_CONFIG   ssh config path (default: ~/.ssh/config)
  SERVER_SSH          ssh binary (default: ssh)
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    '' | pick) cmd_connect ;;
    list) cmd_list ;;
    info)
      (($# >= 2)) || { echo 'Usage: server info <name>' >&2; return 2; }
      cmd_info "$2"
      ;;
    rm)
      (($# >= 2)) || { echo 'Usage: server rm <name>' >&2; return 2; }
      cmd_rm "$2"
      ;;
    add) cmd_add ;;
    edit)
      if (($# >= 2)); then
        cmd_edit "$2"
      else
        cmd_edit
      fi
      ;;
    help | -h | --help) usage ;;
    version | --version) echo "server $VERSION" ;;
    *)
      if [[ "$cmd" == -* ]]; then
        echo "Unknown option: $cmd (see 'server help')" >&2
        return 2
      fi
      cmd_connect "$cmd"
      ;;
  esac
}

main "$@"
